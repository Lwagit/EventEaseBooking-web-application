@model IEnumerable<EventEaseBookingApp.Models.BookingViewModel>

@{
    ViewData["Title"] = "Bookings";
}

<h1 class="mb-4">Bookings</h1>
<form method="get" class="row g-3 mb-4">

    <div class="col-md-3">
        <input type="text"
               name="search"
               class="form-control"
               placeholder="Search booking/event/venue" />
    </div>

    <div class="col-md-2">
        <select name="eventTypeId" class="form-select">
            <option value="">All Event Types</option>

            @foreach (var item in ViewBag.EventTypes)
            {
                <option value="@item.Value">
                    @item.Text
                </option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <input type="date"
               name="startDate"
               class="form-control" />
    </div>

    <div class="col-md-2">
        <input type="date"
               name="endDate"
               class="form-control" />
    </div>

    <div class="col-md-2">
        <select name="venueAvailable" class="form-select">
            <option value="">All Venues</option>
            <option value="true">Available</option>
            <option value="false">Unavailable</option>
        </select>
    </div>

    <div class="col-md-1">
        <button type="submit"
                class="btn btn-primary w-100">
            Filter
        </button>
    </div>

</form>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Booking</a>
</p>

@if (!Model.Any())
{
    <p>No bookings found.</p>
}
else
{
    <table class="table table-striped table-hover shadow-sm rounded">
        <thead class="table-primary">
            <tr>
                <th>Booking Date</th>
                <th>Venue</th>
                <th>Event</th>
                <th>Actions</th>
                <th>Event Type</th>
                <th>Venue Available</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.BookingDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@booking.VenueName</td>
                    <td>@booking.EventName</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                        <a asp-action="Details" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-info me-1">Details</a>
                        <a asp-action="Delete" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                    <td>@booking.EventTypeName</td>
                    <td>@(booking.VenueAvailable ? "Yes" : "No")</td>
                    
                </tr>
            }
        </tbody>
    </table>
}